# ==============================================================================
# HEALTHMATE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running the application:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux / macOS)

# 1. Core Application
PROJECT_NAME="HealthMate AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # development | staging | production
DEBUG=True

# 2. Database
# Supabase PostgreSQL (recommended for production):
# Find connection string at: Dashboard → Settings → Database → Transaction pooler
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"
# Local SQLite fallback (development / migration period):
# DATABASE_URL="sqlite:///./healthmate.db"

# 3. Cryptographic Security & JWT Authentication
# Secret key used for signing FastAPI JWT tokens
SECRET_KEY="healthmate_dev_secret_key_change_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. CORS Allowed Origins
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]'

# 5. File Storage & Upload Constraints
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# 6. Supabase Integration (REQUIRED for PostgreSQL + Storage + Auth sync)
# SUPABASE_URL        — your project URL (safe to log but don't commit to git)
# SUPABASE_SECRET_KEY — service_role key (BACKEND ONLY — NEVER expose to frontend)
#   Find both at: Supabase Dashboard → Settings → API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_YOUR_SERVICE_ROLE_KEY_HERE"

# 7. Google OAuth / OIDC (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# 8. Optional LLM Clinical Copilot Keys (Local Hybrid RAG active by default)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_PROVIDER="auto" # auto | gemini | openai | local_fallback

# 9. Logging & Diagnostics
LOG_LEVEL="INFO"

# ==============================================================================
# FRONTEND — create frontend/.env with these values (VITE_ prefix required)
# ==============================================================================
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_ANON_KEY_HERE
