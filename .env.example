# ==============================================================================
# HEALTHMATE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running the application:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux / macOS)

# 1. Core Application
PROJECT_NAME="HealthMate AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # development | staging | production
DEBUG=True

# 2. Database Persistence
# Default: Local SQLite Database
DATABASE_URL="sqlite:///./healthmate.db"

# Future PostgreSQL / Supabase Integration Example:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# 3. Cryptographic Security & JWT Authentication
# Secret key used for signing JWT tokens and SHA-256 session integrity
SECRET_KEY="healthmate_dev_secret_key_change_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. CORS Allowed Origins (JSON array or comma-separated URLs)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]'

# 5. File Storage & Upload Constraints
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# 6. Google OAuth / OIDC (Optional - Local Development Fallback Active by Default)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# 7. Optional LLM Clinical Copilot Keys (Optional - Local Hybrid RAG Active by Default)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_PROVIDER="auto" # auto | gemini | openai | local_fallback

# 8. Logging & Diagnostics
LOG_LEVEL="INFO"
